              "name": "Geo Hero",
              "model": "geo-hero",
              "content_default": "<h2>Discover opportunities near you</h2><p>Explore programs and events available across the country.</p><p><a href=\"#programs\">Explore all programs</a></p>",
              "content_fl": "<h2>Find programs in Florida</h2><p>Discover local events and resources for Florida communities.</p><p><a href=\"#programs\">Explore Florida programs</a></p>",
              "content_ny": "<h2>Explore opportunities in New York</h2><p>Find regional events, programs, and resources across New York.</p><p><a href=\"#programs\">Explore New York programs</a></p>",
              "content_tn": "<h2>Discover programs in Tennessee</h2><p>Connect with local events and resources across Tennessee.</p><p><a href=\"#programs\">Explore Tennessee programs</a></p>"
            }
          }
        }
      }
    }
